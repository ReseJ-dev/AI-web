APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db
SOURCE_POLICY_CONFIG_DIR=config
BRAVE_SEARCH_API_KEY=
SEARCH_RESULT_RETENTION_ALLOWED=false
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RETRIES=3
SEARCH_BACKOFF_SECONDS=0.5
PROJECT_USER_AGENT=AIWebResearchAgent/0.1
ROBOTS_CACHE_TTL_SECONDS=3600
ROBOTS_STRICT_MODE=true
COMPLIANCE_HTTP_TIMEOUT_SECONDS=10
TERMS_MAX_DOCUMENTS=3
HTML_CONTENT_MAX_CHARS=20000
LLM_PROVIDER=disabled
LLM_MODEL=not-configured
LLM_API_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_HTTP_MAX_RETRIES=2
LLM_RESPONSE_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_INPUT_CHARS=60000
RESEARCH_SEARCH_BUDGET=20
RESEARCH_SEARCH_PAGE_SIZE=20
RESEARCH_CRAWL_PAGE_LIMIT=5
CRAWLER_REQUEST_DELAY_SECONDS=1
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RETRY_AFTER_SECONDS=120
OPENCORPORATES_API_KEY=

OPENCORPORATES_LICENSED_DATA_USE_ALLOWED=false
OPENCORPORATES_TIMEOUT_SECONDS=10
OPENCORPORATES_MAX_RETRIES=3
OPENCORPORATES_BACKOFF_SECONDS=0.5
OPENCORPORATES_MAX_RETRY_AFTER_SECONDS=60
WIKIDATA_ENABLED=false
GEONAMES_USERNAME=
